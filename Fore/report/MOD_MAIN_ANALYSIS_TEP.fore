Var
	MB: IMetabase;
	wsData: ITabSheet;
	_sqlText: String;

Const
	C_PARAM_SQL = "P_SQL";
	C_DB_ID = "CONNECT_SNG_DB_BA_PHD";
	C_NAMESPACE_ID = "BA_PHD";
	WS_DATA_NAME = "Лист1";
	C_TRACE_COL = 200;
	C_LOG_ID = "LOG_PHD_TEP_ANALIS_JOURNAL";
	C_LOG_OP_LOAD = "Выгрузка ТЭП (отчёт)";
	C_NUM_FORMAT = "#,##0.00";
	C_COL_WIDTH = 22;

/// <summary>
/// 	Точка входа: получает готовый текст SQL из параметра отчёта P_SQL,
/// 	выполняет его напрямую через соединение БД и выгружает результат на «Лист1».
/// 	SQL целиком собирается в модуле веб-формы, объект-запрос не используется.
/// </summary>
Sub loadQueryDataToSheet(Report: IPrxReport);
Var
	sql: String;
Begin
	step_Ok("1/4 старт", "получение SQL из параметра " + C_PARAM_SQL);
	sql := getParamText(Report, C_PARAM_SQL);
	_sqlText := sql;
	If sql.IsEmpty Then
		step_FailText("1/4 старт", "параметр " + C_PARAM_SQL + " пуст — SQL не передан из формы");
		showOnSheet(Report, "SQL не передан: параметр " + C_PARAM_SQL + " пуст");
		Return;
	End If;
	step_Ok("1/4 SQL получен", "длина " + sql.Length.ToString + " симв.");
	Try
		executeAndDump(Report, sql);
	Except On E: Exception Do
		step_Fail("4/4 выгрузка", E);
		showOnSheet(Report, "сбой выгрузки: " + errText(E));
	End Try;
End Sub loadQueryDataToSheet;

/// <summary>Выполняет SQL и выгружает результат на лист данных</summary>
Sub executeAndDump(Report: IPrxReport; sql: String);
Var
	dbIns: IDatabaseInstance;
	cmd: IDalCommand;
	cur: IDalCursor;
	fieldCount, row, col, rowCount: Integer;
Begin
	dbIns := getDatabase;
	If IsNull(dbIns) Then
		step_FailText("2/4 соединение", "не найдено соединение " + C_DB_ID);
		showOnSheet(Report, "не найдено соединение БД " + C_DB_ID);
		Return;
	End If;
	wsData := getDataSheet(Report);
	If IsNull(wsData) Then
		step_FailText("2/4 лист", "не найден лист " + WS_DATA_NAME);
		Return;
	End If;
	step_Ok("2/4 соединение", "соединение " + C_DB_ID + ", лист " + WS_DATA_NAME);
	wsData.BeginUpdate;
	wsData.Clear;
	writeTrace(0, 0, sql);
	cmd := dbIns.Connection.CreateCommand(sql);
	cur := cmd.CreateCursor;
	Try
		fieldCount := cursorFieldCount(cur);
		step_Ok("3/4 запрос", "колонок в результате: " + fieldCount.ToString);
		For col := 1 To fieldCount Do
			writeText(1, col, cursorFieldName(cur, col - 1));
		End For;
		row := 2;
		rowCount := 0;
		While Not cur.Eof Do
			For col := 1 To fieldCount Do
				writeValue(row, col, cursorCellValue(cur, col - 1));
			End For;
			row := row + 1;
			rowCount := rowCount + 1;
			cur.Next;
		End While;
		formatSheet(fieldCount, row - 1);
		step_Ok("4/4 выгрузка", "строк " + rowCount.ToString + ", готово");
		writeTrace(C_TRACE_COL, 0, "готово, строк: " + rowCount.ToString);
	Except On E: Exception Do
		step_Fail("3/4 запрос", E);
		Try cur.Close; Except On E2: Exception Do End Try;
		Try cmd.Close; Except On E3: Exception Do End Try;
		wsData.EndUpdate;
		Raise E;
	End Try;
	Try cur.Close; Except On E4: Exception Do End Try;
	Try cmd.Close; Except On E5: Exception Do End Try;
	wsData.EndUpdate;
End Sub executeAndDump;

/// <summary>Соединение с БД для прямого исполнения SQL</summary>
Function getDatabase: IDatabaseInstance;
Var
	mb: IMetabase;
Begin
	mb := MetabaseClass.Active;
	If IsNull(mb) Then Return Null; End If;
	Try
		Return mb.ItemById(C_DB_ID).Open(Null) As IDatabaseInstance;
	Except On E: Exception Do
		Try
			Return mb.ItemByIdNamespace(C_DB_ID, mb.GetObjectKeyById(C_NAMESPACE_ID)).Open(Null) As IDatabaseInstance;
		Except On E2: Exception Do
			Debug.WriteLine("[АнализТЭП] соединение не открыто: " + E2.Message);
			Return Null;
		End Try;
	End Try;
End Function getDatabase;

/// <summary>Текст параметра отчёта</summary>
Function getParamText(Report: IPrxReport; paramId: String): String;
Var
	params: IMetabaseObjectParamValues;
	param: IMetabaseObjectParamValue;
Begin
	Try
		params := Report.MetabaseObjectInstance.ParamValues;
		If IsNull(params) Then Return ""; End If;
		param := params.FindById(paramId);
		If IsNull(param) Or IsNull(param.Value) Then Return ""; End If;
		Return param.Value As String;
	Except On E: Exception Do
		Debug.WriteLine("[АнализТЭП] параметр " + paramId + ": " + E.Message);
		Return "";
	End Try;
End Function getParamText;

/// <summary>Лист с данными</summary>
Function getDataSheet(Report: IPrxReport): ITabSheet;
Var
	i: Integer;
Begin
	Try
		If Not IsNull(Report.Sheets.FindByName(WS_DATA_NAME)) Then
			Return (Report.Sheets.FindByName(WS_DATA_NAME) As IPrxTable).TabSheet;
		End If;
	Except On E: Exception Do End Try;
	If Report.Sheets.Count = 0 Then Return Null; End If;
	For i := 0 To Report.Sheets.Count - 1 Do
		Try
			Return Report.Sheets.Item(i) As ITabSheet;
		Except On E2: Exception Do End Try;
	End For;
	Return Null;
End Function getDataSheet;

Function cursorFieldCount(cur: IDalCursor): Integer;
Begin
	Try Return cur.Fields.Count; Except On E: Exception Do Return 0; End Try;
End Function cursorFieldCount;

Function cursorFieldName(cur: IDalCursor; index: Integer): String;
Begin
	Try Return cur.Fields.Item(index).Name As String; Except On E: Exception Do Return ""; End Try;
End Function cursorFieldName;

Function cursorCellValue(cur: IDalCursor; index: Integer): Variant;
Begin
	Try Return cur.Fields.Item(index).Value; Except On E: Exception Do Return Null; End Try;
End Function cursorCellValue;

Sub writeText(row, col: Integer; text: String);
Begin
	Try wsData.Cell(row, col).Value := text; Except On E: Exception Do End Try;
End Sub writeText;

Sub writeValue(row, col: Integer; value: Variant);
Begin
	Try wsData.Cell(row, col).Value := value; Except On E: Exception Do End Try;
End Sub writeValue;

Sub writeTrace(col, row: Integer; text: String);
Begin
	Try wsData.Cell(row, col).Value := text; Except On E: Exception Do End Try;
End Sub writeTrace;

/// <summary>Оформление: жирные заголовки, ширины, числовой формат</summary>
Sub formatSheet(colCount, lastRow: Integer);
Var
	col: Integer;
Begin
	Try
		For col := 1 To colCount Do
			wsData.Column(col - 1).ColumnWidth := C_COL_WIDTH;
		End For;
	Except On E: Exception Do End Try;
	Try
		For col := 1 To colCount Do
			wsData.Cell(1, col).Style.Font.Bold := tristate.OnOption;
		End For;
	Except On E2: Exception Do End Try;
	Try
		If lastRow >= 2 Then
			wsData.Cells(2, 1, lastRow, colCount).Style.CustomFormat := "";
		End If;
	Except On E3: Exception Do End Try;
End Sub formatSheet;

/// <summary>Вывести сообщение на лист (для диагностики)</summary>
Sub showOnSheet(Report: IPrxReport; text: String);
Begin
	Try
		wsData := getDataSheet(Report);
		If Not IsNull(wsData) Then
			wsData.BeginUpdate;
			wsData.Clear;
			wsData.Cell(0, 0).Value := text;
			wsData.EndUpdate;
		End If;
	Except On E: Exception Do
		Debug.WriteLine("[АнализТЭП] " + E.Message);
	End Try;
End Sub showOnSheet;

/// <summary>Запись в журнал</summary>
Sub logRecord(op: String; success: Boolean; objId: String; objName: String; descr: String);
Var
	desc: IMetabaseObjectDescriptor;
	logObj: ILog;
	vals: Array Of Variant;
Begin
	Try
		desc := MB.ItemById(C_LOG_ID);
		If IsNull(desc) Then
			desc := MB.ItemByIdNamespace(C_LOG_ID, MB.GetObjectKeyById(C_NAMESPACE_ID));
		End If;
		logObj := desc.Open(Null) As ILog;
		vals := New Variant[7];
		vals[0] := Now;
		vals[1] := currentUserName;
		vals[2] := op;
		If success Then vals[3] := 1; Else vals[3] := 0; End If;
		vals[4] := objId;
		vals[5] := objName;
		vals[6] := cut(descr, 500);
		logObj.PutRecord(vals);
	Except On E: Exception Do
		Debug.WriteLine("[АнализТЭП] журнал: " + E.Message);
	End Try;
End Sub logRecord;

Sub step_Ok(step_: String; info: String);
Begin
	logRecord(C_LOG_OP_LOAD, True, WS_DATA_NAME, "", step_ + ": " + info);
End Sub step_Ok;

Sub step_Fail(step_: String; E: Exception);
Begin
	logRecord(C_LOG_OP_LOAD, False, WS_DATA_NAME, "", step_ + ": " + errText(E));
End Sub step_Fail;

Sub step_FailText(step_: String; reason: String);
Begin
	logRecord(C_LOG_OP_LOAD, False, WS_DATA_NAME, "", step_ + ": " + reason);
End Sub step_FailText;

Function errText(E: Exception): String;
Var
	text: String;
Begin
	If IsNull(E) Then Return "неизвестная ошибка"; End If;
	Try
		text := E.Message;
		If Not IsNull(E.Source) And Not (E.Source As String).IsEmpty Then text := text + " [" + (E.Source As String) + "]"; End If;
		If Not IsNull(E.Line) Then text := text + " стр." + (E.Line As Integer).ToString; End If;
	Except On E2: Exception Do End Try;
	Return cut(text, 400);
End Function errText;

Function cut(text: String; maxLen: Integer): String;
Begin
	If IsNull(text) Then Return ""; End If;
	If text.Length > maxLen Then Return text.SubString(0, maxLen) + "…"; End If;
	Return text;
End Function cut;

Function currentUserName: String;
Begin
	Try
		If Not IsNull(MB) Then
			If Not IsNull(MB.LogonSession) Then
				If Not IsNull(MB.LogonSession.User) Then
					Return MB.LogonSession.User.FullName As String;
				End If;
			End If;
		End If;
	Except On E: Exception Do End Try;
	Return "";
End Function currentUserName;
