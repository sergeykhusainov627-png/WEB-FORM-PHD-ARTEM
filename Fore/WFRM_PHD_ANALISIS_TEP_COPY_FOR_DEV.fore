	Function getCollectionValues(dim: IWebDimensionCombo): StringList;
	Var
		dimValuesByAttr: StringList;
		arrValue: Variant;
		myArray: Array Of Variant;
		i: Integer;
	Begin
		dimValuesByAttr := New StringList.Create;
		
		If dim.Selection.MultiSelect Then
			//TextArea1.Text := (dim.Selection.ToVariant Is Array);
			
			If dim.Selection.ToVariant Is Array Then
				arrValue := dim.Selection.ToVariant;
				For i:= 0 To myArray.Length -1 do
					TextArea1.Text := myArray[i] As String;
				End For;
			 
				// ElemArr := (dim.Selection.ToVariant As Array);
				// Elems := ElemArr.Elements;
				// Iter := Elems.Iterator;
				
				// While Iter.Next Do
				// 	//Debug.WriteLine(Elems.Name(Iter.Element));
				// 	TextArea1.Text := Iter.Element.ToString;
				// End While;
			End If;
			
			// If dim.Selection.SelectedCount = 1 Then
			// 	TextArea1.Text := dim.Selection.SelectedCount.ToString;
			// Else
			// 	TextArea1.Text := dim.Selection.SelectedCount.ToString;
			// End If;
			
			// If dim.Selection.ToVariant Is Array Then
			// 	//TextArea1.Text := "Это массив";
			// End If;		
			
		End If;
	
		Return dimValuesByAttr;
	End Function getCollectionValues;
	
