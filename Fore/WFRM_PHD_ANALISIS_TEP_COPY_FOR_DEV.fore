	Sub I_ZINDTXT1OnTextChanged;
	Begin
		
	End Sub I_ZINDTXT1OnTextChanged;
	
	Sub UpdateOpenDefHlinkFromSelection(paramId: String; dimSel: IDimSelection; attrId: String = "");
	Var
		paramValue: Variant;
	Begin
		paramValue := WebFormsExt.GetDimSelectionAttrValue(dimSel, attrId);
		UpdateOpenDefHlink(paramId, paramValue);
	End Sub UpdateOpenDefHlinkFromSelection;
	
	Sub UpdateOpenDefHlink(paramId: String; paramValue: Variant);
	Var
		hlinkAction, paramValueSubStr: String;
		paramIndex, paramValueIndex: Integer;
		
		Sub InsertParam;
		Begin
			// Если это первый параметр - обычная вставка. Если не первый - добавляем перед параметров символ ";"
			If hlinkAction.Chars(hlinkAction.Length-2) = "(" Then
				hlinkAction := String.Insert(hlinkAction, hlinkAction.Length-1, String.Format("{0}={1}", paramId, paramValue));
			Else
				hlinkAction := String.Insert(hlinkAction, hlinkAction.Length-1, String.Format(";{0}={1}", paramId, paramValue));
			End If;
		End Sub InsertParam;
		
		Sub UpdateParam;
		Begin
			// Удаляем текущее значение параметра и вставляем новое
			paramValueIndex := hlinkAction.SubString(paramIndex).IndexOf("=") + paramIndex + 1;
			paramValueSubStr := hlinkAction.SubString(paramValueIndex);
			
			With nextParamIndex: paramValueSubStr.IndexOf(";"), endParamsIndex: paramValueSubStr.IndexOf(")") Do
				// Удаляем текущее значение
				If nextParamIndex = -1 Then
					hlinkAction := String.Remove(hlinkAction, paramValueIndex, endParamsIndex);
				Else
					hlinkAction := String.Remove(hlinkAction, paramValueIndex, nextParamIndex);
				End If;
				
				// Вставляем новое
				hlinkAction := String.Insert(hlinkAction, paramValueIndex, String.Format("{0}", paramValue));
			End With;
		End Sub UpdateParam;
		
		Sub RemoveParam;
		Begin
			// Удаляем текущее значение параметра
			paramValueIndex := hlinkAction.SubString(paramIndex).IndexOf("=") + paramIndex + 1;
			paramValueSubStr := hlinkAction.SubString(paramValueIndex);
			
			With nextParamIndex: paramValueSubStr.IndexOf(";"), endParamsIndex: paramValueSubStr.IndexOf(")") Do
				// Удаляем текущее значение
				If nextParamIndex = -1 Then
					If hlinkAction.Chars(paramIndex - 1) = "(" Then
						hlinkAction := String.Remove(hlinkAction, paramIndex, paramValueIndex - paramIndex + endParamsIndex);
					Else
						hlinkAction := String.Remove(hlinkAction, paramIndex - 1, paramValueIndex - paramIndex + endParamsIndex + 1);
					End If;
				Else
					
					hlinkAction := String.Remove(hlinkAction, paramIndex, paramValueIndex - paramIndex + nextParamIndex + 1);
				End If;
			End With;
		End Sub RemoveParam;
		
		Function GetParamIndex: Integer;
		Var
			subStr: String = "";
			subStrParamIndex: Integer;
		Begin
			// Обработка случая, когда в строке есть PARAM1 и PARAM13, например (иденты параметров частично совпадают)
			subStrParamIndex := hlinkAction.IndexOf(paramId);
			subStr := hlinkAction.SubString(subStrParamIndex, hlinkAction.SubString(subStrParamIndex).IndexOf("="));
			
			While (Not (subStr = paramId)) And (Not (subStrParamIndex = -1)) Do
				subStrParamIndex := hlinkAction.IndexOf(paramId, subStrParamIndex + 1);
				subStr := hlinkAction.SubString(subStrParamIndex, hlinkAction.SubString(subStrParamIndex).IndexOf("="));
			End While;
			
			Return subStrParamIndex;
		End Function GetParamIndex;
		
		Sub UpdateArrayToValue;
		Var
			i: Integer;
			paramValueArr: Array;
		Begin
			If IsNull(paramValue) Or paramValue.IsEmpty Then
				Return;
			End If;
			
			If paramValue Is Array Then
				paramValueArr := paramValue As Array;
				paramValue := "[";
				For i := 0 To paramValueArr.Length - 1 Do
					paramValue := paramValue + paramValueArr[i] + ",";
				End For;
				paramValue := String.Remove(paramValue, (paramValue As String).Length - 1);
				paramValue := paramValue + "]";
			End If;
		End Sub UpdateArrayToValue;
	Begin
		// В РО изначально лежит Action формата @DEF_FOR_F4
		hlinkAction := _hlink.Action;
		
		// Вставляем скобки для передачи параметров
		If Not (String.Contains(hlinkAction, "(")) Then
			hlinkAction := String.Insert(hlinkAction, hlinkAction.Length, "()");
		End If;
		
		// Если параметр - массив, то преобразуем в строку
		UpdateArrayToValue;
		
		// Проверяем, есть ли уже данный параметр в гиперссылке. Если есть - меняем, если нет - вставляем
		paramIndex := GetParamIndex;
		If Not (paramIndex = -1) Then
			// Если пришло пустое значение - чистим параметр из строки
			If IsNull(paramValue) Or paramValue.IsEmpty Then
				RemoveParam;
			Else
				UpdateParam;
			End If;
		Else
			InsertParam;
		End If;
		
		_hlink.Action := hlinkAction;
		TextArea1.Lines.Add(hlinkAction);
	End Sub UpdateOpenDefHlink;
	
	Function InitializeHlinkOpenObject(report: IPrxReport; hlinkText, hlinkAction: String): ITabHyperlink;
	Var
		hlinkCell: ITabRange;
		hlinkCellStyle: ITabCellStyle;
		hlink: ITabHyperlink;
	Begin
		hlinkCell := (report.ActiveSheet As ITabSheet).Cell(0, 0);
		
		// Настройка визуальной составляющей кнопки
		hlinkCellStyle := hlinkCell.Style;
		hlinkCellStyle.HorizontalAlignment := TabFormatAlignment.Center;
		hlinkCellStyle.VerticalAlignment := TabFormatLayout.Center;
		hlinkCellStyle.BorderColor(TabBorder.All) := ButtonCancel.Color;
		hlinkCellStyle.BackgroundBrush := New GxSolidBrush.Create(ButtonCancel.Color);
		hlinkCellStyle.Font.Size := 14;
		hlinkCellStyle.Font.Name := "Roboto";
		hlinkCellStyle.Font.Color := GxColor.FromName("White");
		
		// Создание гиперссылки
		TabExt.SetTabHyperlink(hlinkCell, hlinkText, TabHyperlinkActionType.OpenObject, hlinkAction, True);
		hlink := hlinkCell.Style.Hyperlink;
		hlink.Underline := TriState.OffOption;
		hlink.Color := GxColor.FromName("White");
		
		Return hlink;
	End Function InitializeHlinkOpenObject;

	Sub CB_ZHRGRPMOOnChange;
	Begin
		fillFieldListByStatusFlag(CB_ZHRGRPMO, "ZHRGRPMO");
	End Sub CB_ZHRGRPMOOnChange;
	
	Sub fillFieldListByStatusFlag(CB: IWebCheckBox; fieldName : String);
	Begin	
		If CB <> Null Then
			If CB.Checked Then
				fieldList.Add(fieldName);
			Else
				fieldList.Remove(fieldName);
			End If;
			Hyperlink.SetParamValue("P_FIELD_LIST", fieldList.Text(", "));
			Hyperlink.Generate;
			TextArea1.Text := Hyperlink.Action;
		End If;		
	End Sub fillFieldListByStatusFlag;
	
	Sub addDefaultFieldsToStringList;
	Begin
		fieldList.Add("CALYEAR,PLANT,ZLIB_INDC");
		//fieldList.Add("PLANT");
		//fieldList.Add("ZLIB_INDC");
	End Sub addDefaultFieldsToStringList;

End Class ANALIZ_TEP_FORM_ON_SHOW;

