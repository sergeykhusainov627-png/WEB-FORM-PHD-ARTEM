	/// <summary>
	/// 	Передаёт значение отметки в гиперссылку. Значение пишется в менеджер параметров
	/// 	(CObjectParamManager), из которого строку действия собирает COpenHyperlink.Generate.
	/// 	Ручная сборка строки не нужна: Generate всё равно пересобирает её из менеджера параметров.
	/// </summary>
	Sub UpdateOpenDefHlinkFromSelection(paramId: String; dimSel: IDimSelection; attrId: String = "");
	Begin
		If IsNull(dimSel) Then Return; End If;
		Hyperlink.SetParamValueFromSelection(paramId, dimSel, attrId);
	End Sub UpdateOpenDefHlinkFromSelection;
	
	/// <summary>
	/// 	Здесь был ручной разбор строки действия (UpdateOpenDefHlink + 5 вложенных подпрограмм).
	/// 	Он удалён: COpenHyperlink.Generate пересобирает строку из менеджера параметров и затирает
	/// 	ручную правку, а сам разбор мог падать на String.SubString(-1) при отсутствующем параметре.
	/// </summary>
	
	Function InitializeHlinkOpenObject(report: IPrxReport; hlinkText, hlinkAction: String): ITabHyperlink;
	Var
		hlinkCell: ITabRange;
		hlinkCellStyle: ITabCellStyle;
		hlink: ITabHyperlink;
	Begin
		hlinkCell := (report.ActiveSheet As ITabSheet).Cell(0, 0);
		
		// Настройка визуальной составляющей кнопки
		hlinkCellStyle := hlinkCell.Style;
		hlinkCellStyle.HorizontalAlignment := TabFormatAlignment.Center;
		hlinkCellStyle.VerticalAlignment := TabFormatLayout.Center;
		hlinkCellStyle.BorderColor(TabBorder.All) := ButtonCancel.Color;
		hlinkCellStyle.BackgroundBrush := New GxSolidBrush.Create(ButtonCancel.Color);
		hlinkCellStyle.Font.Size := 14;
		hlinkCellStyle.Font.Name := "Roboto";
		hlinkCellStyle.Font.Color := GxColor.FromName("White");
		
		// Создание гиперссылки
		TabExt.SetTabHyperlink(hlinkCell, hlinkText, TabHyperlinkActionType.OpenObject, hlinkAction, True);
		hlink := hlinkCell.Style.Hyperlink;
		hlink.Underline := TriState.OffOption;
		hlink.Color := GxColor.FromName("White");
		
		Return hlink;
	End Function InitializeHlinkOpenObject;

