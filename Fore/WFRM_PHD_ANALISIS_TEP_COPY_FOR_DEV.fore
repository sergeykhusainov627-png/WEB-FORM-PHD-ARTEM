	Private Function getUserSP: String;
	Var
		userSP: String;
		User: IMetabaseUser;
	Begin
		User := MetabaseClass.Active.LogonSession.User; //Получаем пользователя запустившего отчет
		userSP := User.Attributes.FindById("BUS_AREA").Value; //Получаем значение атрибута "BUS_AREA"
		Return userSP;
	End Function getUserSP;
	
