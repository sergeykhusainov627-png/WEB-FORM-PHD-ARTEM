	/// <summary>
	/// 	Обработчик чек-бокса «Поля для вывода». Идентификатор поля берётся из таблицы
	/// 	InitOutputFieldIds по имени контрола, поэтому список всегда пересобирается целиком.
	/// </summary>
	Sub fillFieldListByStatusFlag(CB: IWebCheckBox; fieldName : String);
	Begin	
		If IsNull(CB) Then Return; End If;
		RefreshFieldList;
	End Sub fillFieldListByStatusFlag;
	
	/// <summary>
	/// 	Поля, выводимые без чек-бокса. Сейчас это только «Год»: контрола CB_CALYEAR в форме нет,
	/// 	а в ТТ «Год» — поле вывода «по умолчанию» (лист «СЭ - поля для вывода»), поэтому он
	/// 	всегда попадает в P_FIELD_LIST. Остальные поля попадают туда ТОЛЬКО если их чек-бокс отмечен:
	/// 	не отмечен — поля (и колонки) в отчёте нет.
	/// 	Если для «Года» появится чек-бокс — убрать строку ниже, завести поле в InitOutputFieldIds
	/// 	и уточнить идентификатор: CALYEAR (как в исходном модуле) или YEAR (как в ТТ).
	/// </summary>
	Sub addFieldsWithoutCheckBox;
	Begin
		addFieldToList("CALYEAR");   // Год
	End Sub addFieldsWithoutCheckBox;



	// ============================================================================================
	//  «Поля для вывода» — идентификаторы полей отчёта для параметра P_FIELD_LIST
	//
	//  Источник: ТТ «Анализ и выгрузка данных ТЭП», лист «Вывод полей в отчете» (колонка «Поле»).
	//  Идентификаторы, помеченные «уточнить», в ТТ не указаны — приняты по имени поля/контрола;
	//  при расхождении с отчётом PRX_ANALYSIS_TEP правьте ТОЛЬКО этот метод.
	//
	//  Чего пока нет (нужны контролы в дизайнере формы):
	//    * группа «Значения ТЭП с начала года»  — 19 полей, источник TBL_PHD_FAP_MULT.ZVALUE_SNG;
	//    * группа «Значения корректировок ТЭП»   — 19 полей, ZSIU_INDV + ZLIB_INFS=KOROUND;
	//    * «Класс вида оборудования» (ZCLSVOBOR) — есть поле в ТТ, контрола на форме нет;
	//    * не размечены: CB_ANALYTIC_SET, CB_AREA, CB_ESTIMATED_PRICES, CB_MVP_TEP, CbESO3
	//      (в ТТ не найдены — уточнить назначение).
	// ============================================================================================
	Sub InitOutputFieldIds;
	Begin
		If Not IsNull(_fieldIds) Then Return; End If;
		_fieldIds := New Hashtable.Create;
		_codeIds := New Hashtable.Create;
		// --- подтверждённые поля (контролы используются в исходном модуле) ---
		_fieldIds.Add("CB_ACTTYPE", "ACTTYPE");
		_fieldIds.Add("CB_ACT_UNIT", "ACT_UNIT");
		_fieldIds.Add("CB_COSTCENTER", "COSTCENTER");
		_fieldIds.Add("CB_MATERIAL", "MATERIAL");
