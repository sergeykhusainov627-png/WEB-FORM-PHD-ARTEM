	/// <summary>
	/// 	Гиперссылка
	/// </summary>
	Property Hyperlink: COpenHyperlink
	Get
	Begin
		If IsNull(_AnalyzTepHyperlink) Then
			_AnalyzTepHyperlink := New COpenHyperlink.Create(ReportBoxOk.Report, AppNs.PHD, "Ок");
			_AnalyzTepHyperlink.InitObject(C_ANALYZ_TEP_REP_ID);
		End If;	
		Return _AnalyzTepHyperlink;
	End Get
	End Property Hyperlink;
	
	Sub initialization;
	Begin	
		MB := MetabaseClass.Active;
		If IsNull(fieldList) Then fieldList := New StringList.Create; End If;
		InitOutputFieldIds;
	End Sub initialization;
	
	/// <summary>
	/// 	Значения по умолчанию СЭ (ТТ, лист «Селекционный экран»): год — текущий, СП — из основной
	/// 	записи пользователя, тип данных — «План», плюс набор полей вывода по умолчанию.
	/// </summary>
	Sub setDefaultDimensionValue;
	Begin
		initialization;
		// Год: текущий год
		setComboSelectionByAttribute(D_CALYEAR, C_PARAM_CALYEAR, "NAME", DateTime.Now.Year.ToString);
		// СП: из основной записи пользователя
		setComboSelectionByAttribute(D_PLANT, C_PARAM_PLANT, "CODE", getUserSP);
		// Тип данных: «План» (ID 0000000001)
		setComboSelectionByAttribute(D_ZTYPEIND, C_PARAM_ZTYPEIND, "ID", C_DEFAULT_TYPE_IND);
		// Поля вывода, установленные по умолчанию (ТТ, лист «СЭ - поля для вывода»)
		initOutputDefaults;
		RefreshFieldList;
	End Sub setDefaultDimensionValue;
	
	Private Function getUserSP: String;
	Var
		userSP: String;
		User: IMetabaseUser;
	Begin
		// СП пользователя из основной записи (атрибут BUS_AREA). Ошибки не должны ронять форму.
		userSP := "";
		Try
			User := MB.LogonSession.User; //Получаем пользователя запустившего отчет
			If Not IsNull(User) Then
				userSP := User.Attributes.FindById("BUS_AREA").Value As String; //Получаем значение атрибута "BUS_AREA"
			End If;
		Except
			userSP := "";
		End Try;
		Return userSP;
	End Function getUserSP;
	
	Sub ANALIZ_TEP_FORM_ON_SHOW;
	Begin
		Try
			_hlink := InitializeHlinkOpenObject(ReportBoxOk.Report, "  Ок  ", C_ANALYZ_TEP_REP_ID);
			// Создаёт COpenHyperlink и менеджер параметров (геттер свойства Hyperlink)
			_AnalyzTepHyperlink := Hyperlink;
			// Значения по умолчанию, набор полей вывода и генерация ссылки
			setDefaultDimensionValue;
			// Ограничение выбора СП согласно полномочиям (ТТ, лист «Селекционный экран»)
			applyPlantAccessRights;
		Except On E: Exception Do
			// Ошибка инициализации не должна ломать форму: текст ошибки остаётся в TextArea1
			showError("Ошибка инициализации формы", E);
		End Try;
									
		//SafeGenerate; вернуть
		//Hyperlink.DesingCell(ButtonCancel.Color);								
				
		//madeLinkForMyselfTst;
		//TextArea1.Text := Hyperlink.Action;
		
		// Сбор значений с СЭ 			 
		//openReportTab := ReportBoxOk.Report.ActiveSheet As ITabSheet;
		//optionReport := ReportBoxVariant.Report;
		//br := New GxSolidBrush.Create(Gxcolor.FromKnownColor(GxKnownColor.LightGray));
		//activeButtonColor := ButtonCancel.Color; //New Gxcolor.CreateRGB(70, 142, 240);
		//disabledButtonColor := New Gxcolor.CreateRGB(222, 235, 255);
		//SetOpenRBActivity(False);				
						
	End Sub ANALIZ_TEP_FORM_ON_SHOW;
	
	Sub madeLinkForMyselfTst;
	Var
		link: ITabHyperlink;
		style: ITabCellStyle;	
		openReportTab: ITabSheet;
	Begin
		// tst сделал ссылку сам
		//openReportTab := ReportBoxOk.Report.ActiveSheet As ITabSheet;
		openReportTab := ReportBoxOk.Report.ActiveSheet.Sheets.FindByName("Лист2") As ITabSheet;		
		TextArea1.Text := ReportBoxOk.Report.ActiveSheet.Name;
		
		
		style := openReportTab.Cell(0, 0).Style;		
		link := style.Hyperlink;
		link.ActionType := TabHyperlinkActionType.OpenObject;
		link.Action := String.Format("@{0}(PLANT={1};CALYEAR={2};ZLIB_INDC={3})", C_ANALYZ_TEP_REP_ID, "6500", "2026", "IND00005000");	
		// link.Action := String.Format("@{0}(PLANT={1};CALYEAR={2};ZLIB_INDC={3}; ANALYTIC_SET={4})", 
		// 																							C_ANALYZ_TEP_REP_ID, 
		// 																							"6500", 
		// 																							"2026", 
		// 																							"IND00005000",
		// 																							"[CALYEAR,PLANT,ZLIB_INDC,ACT_UNIT,MATERIAL]");	
		link.Enable := TriState.OnOption;								
		link.Color := GxColor.FromName("Blue");		
		openReportTab.Cell(0, 0).Value := "tst";
		//TextArea1.Text := link.Action;
	End Sub madeLinkForMyselfTst;	
	
	{Sub UpdateOpenDefHlink(paramId: String; paramValue: Variant);
	Begin
		_AnalyzTepHyperlink.SetParamValue(paramId, paramValue);
		_AnalyzTepSafeGenerate;
	End Sub UpdateOpenDefHlink;}
	
	{Function InitializeHlinkOpenObject(report: IPrxReport; hlinkText, hlinkAction: String): ITabHyperlink;
	Var
		hlinkCell: ITabRange;
		hlinkCellStyle: ITabCellStyle;
		hlink: ITabHyperlink; 
	Begin
		hlinkCell := (report.ActiveSheet As ITabSheet).Cell(0, 0);
		
		// Настройка визуальной составляющей кнопки
		hlinkCellStyle := hlinkCell.Style;
		hlinkCellStyle.HorizontalAlignment := TabFormatAlignment.Center;
		hlinkCellStyle.VerticalAlignment := TabFormatLayout.Center;
		hlinkCellStyle.BorderColor(TabBorder.All) := ButtonCancel.Color;
		hlinkCellStyle.BackgroundBrush := New GxSolidBrush.Create(ButtonCancel.Color);
		hlinkCellStyle.Font.Size := 14;
		hlinkCellStyle.Font.Name := "Roboto";
		hlinkCellStyle.Font.Color := GxColor.FromName("White");
		
		// Создание гиперссылки
		TabExt.SetTabHyperlink(hlinkCell, hlinkText, TabHyperlinkActionType.OpenObject, hlinkAction, False);
		hlink := hlinkCell.Style.Hyperlink;
		hlink.Underline := TriState.OffOption;
		hlink.Color := GxColor.FromName("White");
		
		Return hlink;
	End Function InitializeHlinkOpenObject;}

	/// <summary>
	/// Назначение:
	/// 	Обновление гиперссылки по параметру
	/// Входные параметры:
	/// 	paramName 			- имя параметра 
	/// 	dimSel 				- выбранные значения из справочника
	/// 	attrControlValue	- атрибут справочника, управляющий значением
	/// </summary>
	Sub UpdateHyperlinkParams(paramName: String; dimSel: IDimSelection; attrControlValue: String);
	Begin
		UpdateOpenDefHlinkFromSelection(String.ToUpper(paramName), D_CALYEAR.Selection, String.ToUpper(attrControlValue));
		Hyperlink.SetParamValueFromSelection(String.ToUpper(paramName), D_CALYEAR.Selection, String.ToUpper(attrControlValue));
		SafeGenerate;
	End Sub UpdateHyperlinkParams;

	Sub D_CALYEAROnSelectionChange;
	Begin
		UpdateOpenDefHlinkFromSelection("CALYEAR", D_CALYEAR.Selection, "NAME");
		Hyperlink.SetParamValueFromSelection("CALYEAR", D_CALYEAR.Selection, "NAME");
		SafeGenerate;
		
		//UpdateHyperlinkParams("CALYEAR", D_CALYEAR.Selection, "NAME");
	End Sub D_CALYEAROnSelectionChange;

