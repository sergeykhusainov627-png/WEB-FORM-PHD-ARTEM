	Sub madeLinkForMyselfTst;
	Var
		link: ITabHyperlink;
		style: ITabCellStyle;	
		openReportTab: ITabSheet;
		optionReport: IPrxReport;
		myTstPrxSheeet: IPrxSheet;
	Begin
		// tst сделал ссылку сам
		//openReportTab := ReportBoxOk.Report.ActiveSheet As ITabSheet;
		openReportTab := ReportBoxOk.Report.ActiveSheet.Sheets.FindByName("Лист2") As ITabSheet;		
		TextArea1.Text := ReportBoxOk.Report.ActiveSheet.Name;
		
		
		style := openReportTab.Cell(0, 0).Style;		
		link := style.Hyperlink;
		link.ActionType := TabHyperlinkActionType.OpenObject;
		link.Action := String.Format("@{0}(PLANT={1};CALYEAR={2};ZLIB_INDC={3})", C_ANALYZ_TEP_REP_ID, "6500", "2026", "IND00005000");	
		// link.Action := String.Format("@{0}(PLANT={1};CALYEAR={2};ZLIB_INDC={3}; ANALYTIC_SET={4})", 
		// 																							C_ANALYZ_TEP_REP_ID, 
		// 																							"6500", 
		// 																							"2026", 
		// 																							"IND00005000",
		// 																							"[CALYEAR,PLANT,ZLIB_INDC,ACT_UNIT,MATERIAL]");	
		link.Enable := TriState.OnOption;								
		link.Color := GxColor.FromName("Blue");		
		openReportTab.Cell(0, 0).Value := "tst";
		//TextArea1.Text := link.Action;
	End Sub madeLinkForMyselfTst;	
	
	{Sub UpdateOpenDefHlink(paramId: String; paramValue: Variant);
	Begin
		_AnalyzTepHyperlink.SetParamValue(paramId, paramValue);
		_AnalyzTepHyperlink.Generate;
	End Sub UpdateOpenDefHlink;}
	
	{Function InitializeHlinkOpenObject(report: IPrxReport; hlinkText, hlinkAction: String): ITabHyperlink;
	Var
		hlinkCell: ITabRange;
		hlinkCellStyle: ITabCellStyle;
		hlink: ITabHyperlink; 
	Begin
		hlinkCell := (report.ActiveSheet As ITabSheet).Cell(0, 0);
		
		// Настройка визуальной составляющей кнопки
		hlinkCellStyle := hlinkCell.Style;
		hlinkCellStyle.HorizontalAlignment := TabFormatAlignment.Center;
		hlinkCellStyle.VerticalAlignment := TabFormatLayout.Center;
		hlinkCellStyle.BorderColor(TabBorder.All) := ButtonCancel.Color;
		hlinkCellStyle.BackgroundBrush := New GxSolidBrush.Create(ButtonCancel.Color);
		hlinkCellStyle.Font.Size := 14;
		hlinkCellStyle.Font.Name := "Roboto";
		hlinkCellStyle.Font.Color := GxColor.FromName("White");
		
		// Создание гиперссылки
		TabExt.SetTabHyperlink(hlinkCell, hlinkText, TabHyperlinkActionType.OpenObject, hlinkAction, False);
		hlink := hlinkCell.Style.Hyperlink;
		hlink.Underline := TriState.OffOption;
		hlink.Color := GxColor.FromName("White");
		
		Return hlink;
	End Function InitializeHlinkOpenObject;}

	/// <summary>
	/// Назначение:
	/// 	Обновление гиперссылки по параметру
	/// Входные параметры:
	/// 	paramName 			- имя параметра 
	/// 	dimSel 				- выбранные значения из справочника
	/// 	attrControlValue	- атрибут справочника, управляющий значением
	/// </summary>
	Sub UpdateHyperlinkParams(paramName: String; dimSel: IDimSelection; attrControlValue: String);
	Begin
		UpdateOpenDefHlinkFromSelection(String.ToUpper(paramName), D_CALYEAR.Selection, String.ToUpper(attrControlValue));
		Hyperlink.SetParamValueFromSelection(String.ToUpper(paramName), D_CALYEAR.Selection, String.ToUpper(attrControlValue));
		Hyperlink.Generate;
	End Sub UpdateHyperlinkParams;

	Sub D_CALYEAROnSelectionChange;
	Begin
		UpdateOpenDefHlinkFromSelection("CALYEAR", D_CALYEAR.Selection, "NAME");
		Hyperlink.SetParamValueFromSelection("CALYEAR", D_CALYEAR.Selection, "NAME");
		Hyperlink.Generate;
		
		//UpdateHyperlinkParams("CALYEAR", D_CALYEAR.Selection, "NAME");
	End Sub D_CALYEAROnSelectionChange;

